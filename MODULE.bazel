
module(
    name = "backgammon",
    version = "1.0",
)

bazel_dep(name = "toolchains_llvm", version = "1.5.0")
bazel_dep(name = "rules_cc", version = "0.2.2") 
#bazel_dep(name = "abseil-cpp", version = "20250814.1")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "pybind11_bazel", version = "2.13.6") # The rules repository
bazel_dep(name = "google_benchmark", version = "1.9.4")


llvm_toolchain = use_extension("@toolchains_llvm//toolchain:extension.bzl", "llvm_toolchain")
llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")

llvm_toolchain.register_toolchains(
    name = "clang_linux_x86_64",
    llvm_version = "19.1.0",
    target_triple = "x86_64-unknown-linux-gnu",
)

bazel_dep(name = "googletest", version = "1.17.0")
bazel_dep(name = "cli11", version = "2.5.0")


bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor.git",
    commit = "0e990032f3c5a866e72615cf67e5ce22186dcb97",
)

# Configure and register the toolchain.
llvm.toolchain( llvm_version = "19.1.0",)

use_repo(llvm, "llvm_toolchain")
use_repo(llvm_toolchain, "clang_linux_x86_64")
register_toolchains("@llvm_toolchain//:all")

# Protobuf
bazel_dep(name = "protobuf", version = "29.3")
bazel_dep(name = "rules_proto", version = "7.0.2")

# Onnx
bazel_dep(name = "onnx", version = "1.17.0")

