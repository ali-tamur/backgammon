module(
    name = "backgammon",
    version = "1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.26")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "pybind11_bazel", version = "3.0.1")
bazel_dep(name = "google_benchmark", version = "1.9.5")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "cli11", version = "2.6.2")
bazel_dep(name = "protobuf", version = "33.4")

# C++ toolchain: LLVM 23.1.3, downloaded by Bazel so the build works on any machine.
bazel_dep(name = "toolchains_llvm", version = "1.11.3")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(llvm_version = "23.1.3")
use_repo(llvm, "llvm_toolchain")

register_toolchains("@llvm_toolchain//:all")

# Python: must match the .venv interpreter so the pybind11 module imports.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

# onnxruntime: Microsoft's prebuilt release, built per third_party/onnxruntime.BUILD.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "onnxruntime",
    build_file = "//third_party:onnxruntime.BUILD",
    sha256 = "67db4dc1561f1e3fd42e619575c82c601ef89849afc7ea85a003abbac1a1a105",
    strip_prefix = "onnxruntime-linux-x64-1.20.1",
    urls = ["https://github.com/microsoft/onnxruntime/releases/download/v1.20.1/onnxruntime-linux-x64-1.20.1.tgz"],
)
