common --cxxopt=-std=c++23
common --host_cxxopt=-std=c++23

# Strict warnings for our code; silence third-party code and headers.
build --per_file_copt=^cc/.*@-Wall,-Werror
build --per_file_copt=external/.*@-w
build --host_per_file_copt=external/.*@-w
build --features=external_include_paths
build --host_features=external_include_paths

test --test_output=errors


# Bazel's convenience symlinks (bin, out, testlogs and the execroot) go in .bazel/
# instead of four bazel-* entries at the top; tools/compile_commands.py writes there too.
build --symlink_prefix=.bazel/
